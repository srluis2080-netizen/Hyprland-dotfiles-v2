(include "./modules/panel.yuck")

(include "./modules/clima.yuck")

 (include "./modules/clock.yuck")



;; ── Hover: mostrar al acercar el cursor, ocultar al alejarlo ──
(defvar mostrar-card false)
(defvar mostrar-clima false)

(defwidget tarjeta-hover []
  (eventbox :onhover "${EWW_CMD} update mostrar-card=true"
            :onhoverlost "${EWW_CMD} update mostrar-card=false"
    (box :orientation "h" :space-evenly false :valign "start"
      (revealer :transition "slideleft" :duration "300ms" :reveal mostrar-card
        (box :class "margen-der" (tarjeta)))
      (box :class "handle" :valign "center"))))

(defwidget clima-hover []
  (eventbox :onhover "${EWW_CMD} update mostrar-clima=true"
            :onhoverlost "${EWW_CMD} update mostrar-clima=false"
    (box :orientation "h" :space-evenly false :valign "end"
      (revealer :transition "slideright" :duration "300ms" :reveal mostrar-clima
        (box :class "margen-der" (pixel-clima)))
      (box :class "handle" :valign "center"))))





